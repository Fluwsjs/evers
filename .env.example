# Publieke basis-URL van de site (zonder slash aan het eind)
NEXT_PUBLIC_SITE_URL=https://dakdekkersbedrijfeverstotaalmontage.nl

# Testversie: "true" vraagt zoekmachines om de hele site niet op te nemen (noindex).
# Zet dit aan zolang de site op een testadres staat (bijvoorbeeld *.netlify.app) en het
# echte domein nog naar de oude site wijst. Bij livegang weglaten of op "false" zetten.
SITE_NOINDEX=false

# Toon in de site zichtbare markeringen voor ontbrekende klantgegevens.
# In development standaard aan; zet op "true" om ze ook in een testbuild te zien.
NEXT_PUBLIC_SHOW_TODOS=false

# --- Prijzen ----------------------------------------------------------------
# "true" = de build stopt zolang er onbevestigde (voorbeeld)prijzen in
# config/site.ts staan. Aanbevolen voor de productiebuild. Zonder deze instelling
# waarschuwt de build alleen; onbevestigde prijzen komen hoe dan ook niet op de
# live site (daar staat dan "Prijs op aanvraag").
REQUIRE_CONFIRMED_PRICES=false

# --- Mail -------------------------------------------------------------------
# Verzendmethode: "smtp" of "resend". In productie verplicht; zonder instelling
# kunnen formulieren niet worden verzonden. In development wordt zonder instelling
# naar de map .mail-outbox/ geschreven ("file").
MAIL_PROVIDER=smtp

# Afzender. Gebruik een adres op een domein waarvoor de mailserver mag verzenden
# (SPF/DKIM), anders belandt de mail in de spam.
MAIL_FROM="Evers Totaal Montage <info@voorbeeld.nl>"

# Waar aanvragen binnenkomen. Leeg = het e-mailadres uit config/site.ts.
MAIL_TO=

# SMTP (bij MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
# "true" voor poort 465 (direct TLS); leeg laten voor STARTTLS op 587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Resend (bij MAIL_PROVIDER=resend)
RESEND_API_KEY=

# --- Spambeveiliging --------------------------------------------------------
# Cloudflare Turnstile. Beide leeg = Turnstile uit; honeypot, invultijd en
# rate limit blijven actief.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Statistieken -----------------------------------------------------------
# Plausible: statistieken zonder cookies, dus zonder cookiemelding.
# Leeg = geen statistieken. Vul het domein in zoals het in Plausible staat.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Alleen bij een zelf gehoste Plausible: de volledige URL van het script.
NEXT_PUBLIC_PLAUSIBLE_SRC=
